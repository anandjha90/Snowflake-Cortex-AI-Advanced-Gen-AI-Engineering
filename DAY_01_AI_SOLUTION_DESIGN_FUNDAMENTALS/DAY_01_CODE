-- PURPOSE: Materialise classification once so downstream consumers pay warehouse cost, not token cost, on every read.

CREATE OR REPLACE TABLE FEEDBACK_CLASSIFIED AS
SELECT
    FEEDBACK_ID,
    CUSTOMER_ID,
    FEEDBACK_DATE,
    DEPOT_CODE,
    AI_CLASSIFY(
      FEEDBACK_TEXT,
      ['late delivery', 'damaged goods', 'billing error',
       'cold chain failure', 'positive feedback']
    ) AS ROOT_CAUSE,
    CURRENT_TIMESTAMP() AS CLASSIFIED_AT
FROM CUSTOMER_FEEDBACK;

