-- PURPOSE:       Validate the semantic contract deterministically.
 
SELECT * FROM SEMANTIC_VIEW(
  SALES_PERFORMANCE
  METRICS    orders.m_net_revenue, orders.m_gross_revenue
  DIMENSIONS customers.d_region, orders.d_order_quarter
)
ORDER BY d_order_quarter, d_region;

