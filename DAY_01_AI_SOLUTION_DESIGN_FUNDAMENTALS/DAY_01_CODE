-- PURPOSE: Create the shared training database, schema and sample data used by Labs 1.1 through 1.5.

CREATE DATABASE IF NOT EXISTS AI_SOLUTION_DESIGN_LAB;
CREATE SCHEMA IF NOT EXISTS AI_SOLUTION_DESIGN_LAB.LAB;
 
USE DATABASE AI_SOLUTION_DESIGN_LAB;
USE SCHEMA LAB;
 
CREATE OR REPLACE TABLE CUSTOMERS (
  CUSTOMER_ID    NUMBER(10,0) NOT NULL,
  CUSTOMER_NAME  VARCHAR(200),
  REGION         VARCHAR(50),
  SEGMENT        VARCHAR(50),
  IS_INTERNAL    BOOLEAN,
  CONSTRAINT PK_CUSTOMERS PRIMARY KEY (CUSTOMER_ID)
);
 
CREATE OR REPLACE TABLE PRODUCTS (
  PRODUCT_ID     NUMBER(10,0) NOT NULL,
  PRODUCT_NAME   VARCHAR(200),
  CATEGORY       VARCHAR(50),
  CONSTRAINT PK_PRODUCTS PRIMARY KEY (PRODUCT_ID)
);
 
CREATE OR REPLACE TABLE SALES_ORDERS (
  ORDER_ID       NUMBER(12,0) NOT NULL,
  CUSTOMER_ID    NUMBER(10,0),
  PRODUCT_ID     NUMBER(10,0),
  ORDER_DATE     DATE,
  GROSS_AMOUNT   NUMBER(18,2),
  DISCOUNT_AMOUNT NUMBER(18,2),
  RETURN_AMOUNT  NUMBER(18,2),
  ORDER_STATUS   VARCHAR(20),
  CONSTRAINT PK_SALES_ORDERS PRIMARY KEY (ORDER_ID)
);
 
CREATE OR REPLACE TABLE CUSTOMER_FEEDBACK (
  FEEDBACK_ID    NUMBER(12,0) NOT NULL,
  CUSTOMER_ID    NUMBER(10,0),
  FEEDBACK_DATE  DATE,
  DEPOT_CODE     VARCHAR(20),
  FEEDBACK_TEXT  VARCHAR(5000),
  CONSTRAINT PK_CUSTOMER_FEEDBACK PRIMARY KEY (FEEDBACK_ID)
);

