-- PURPOSE:       Classify free-text delivery feedback into root-cause
--                categories, and derive sentiment, in a single pass.
 
SELECT
    FEEDBACK_ID,
    DEPOT_CODE,
    AI_CLASSIFY(
      FEEDBACK_TEXT,
      ['late delivery', 'damaged goods', 'billing error',
       'cold chain failure', 'positive feedback']
    ) AS ROOT_CAUSE,
    AI_SENTIMENT(FEEDBACK_TEXT) AS SENTIMENT
FROM CUSTOMER_FEEDBACK
WHERE FEEDBACK_DATE >= '2026-04-01';

-------------------------------------------------------------------------------------------------------------------------

-- PURPOSE: Use AI as a predicate and as an aggregate: find feedback indicating a service failure, then summarise by depot.
 
SELECT
    DEPOT_CODE,
    COUNT(*) AS FAILURE_MENTIONS,
    AI_AGG(
      FEEDBACK_TEXT,
      'Summarise the operational failures described in these customer ' ||
      'comments in at most three bullet points. Do not name individuals.'
    ) AS DEPOT_FAILURE_SUMMARY
FROM CUSTOMER_FEEDBACK
WHERE AI_FILTER(
        PROMPT('Does this customer comment describe a service failure? {0}',
               FEEDBACK_TEXT))
GROUP BY DEPOT_CODE
ORDER BY FAILURE_MENTIONS DESC;

