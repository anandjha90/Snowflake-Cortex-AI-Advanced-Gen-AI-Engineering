-- PURPOSE:       Create the governed semantic contract for sales analytics.
--                Demonstrates metrics, synonyms, sample values, question
--                categorisation and a verified query.
 
USE DATABASE AI_SOLUTION_DESIGN_LAB;
USE SCHEMA LAB;
 
CREATE OR REPLACE SEMANTIC VIEW SALES_PERFORMANCE
  TABLES (
    orders AS AI_SOLUTION_DESIGN_LAB.LAB.SALES_ORDERS
      PRIMARY KEY (ORDER_ID)
      WITH SYNONYMS ('sales orders', 'orders')
      COMMENT = 'One row per sales order line for the sales domain',
    customers AS AI_SOLUTION_DESIGN_LAB.LAB.CUSTOMERS
      PRIMARY KEY (CUSTOMER_ID)
      WITH SYNONYMS ('accounts', 'clients')
      COMMENT = 'Customer master, including internal test accounts',
    products AS AI_SOLUTION_DESIGN_LAB.LAB.PRODUCTS
      PRIMARY KEY (PRODUCT_ID)
      COMMENT = 'Product master'
  )
 
  RELATIONSHIPS (
    orders_to_customers AS orders (CUSTOMER_ID) REFERENCES customers,
    orders_to_products  AS orders (PRODUCT_ID)  REFERENCES products
  )
 
  FACTS (
    orders.f_gross      AS GROSS_AMOUNT
      COMMENT = 'Gross order amount before discount and returns',
    orders.f_discount   AS DISCOUNT_AMOUNT
      COMMENT = 'Discount applied to the order',
    orders.f_returns    AS RETURN_AMOUNT
      COMMENT = 'Value returned against the order',
    orders.f_net        AS GROSS_AMOUNT - DISCOUNT_AMOUNT - RETURN_AMOUNT
      COMMENT = 'Net revenue contribution of the order line'
  )
 
  DIMENSIONS (
    orders.d_order_date    AS ORDER_DATE
      COMMENT = 'Date the order was placed',
    orders.d_order_year    AS YEAR(ORDER_DATE)
      COMMENT = 'Calendar year of the order',
    orders.d_order_quarter AS CONCAT(YEAR(ORDER_DATE), '-Q',
                                     QUARTER(ORDER_DATE))
      COMMENT = 'Calendar quarter of the order, format YYYY-Qn',
    orders.d_order_status  AS ORDER_STATUS
      COMMENT = 'Lifecycle status of the order'
      SAMPLE_VALUES ('SHIPPED', 'CANCELLED')
      IS_ENUM,
    customers.d_customer_name AS CUSTOMER_NAME
      WITH SYNONYMS = ('account name', 'client name')
      COMMENT = 'Customer display name',
    customers.d_region     AS REGION
      COMMENT = 'Sales region of the customer'
      SAMPLE_VALUES ('North', 'South', 'East', 'West')
      IS_ENUM,
    customers.d_segment    AS SEGMENT
      COMMENT = 'Commercial segment of the customer'
      SAMPLE_VALUES ('Enterprise', 'Mid-Market', 'SMB', 'Internal'),
    customers.d_is_internal AS IS_INTERNAL
      COMMENT = 'Whether the customer is an internal test account'
      SAMPLE_VALUES ('TRUE', 'FALSE')
      IS_ENUM,
    products.d_category    AS CATEGORY
      COMMENT = 'Product category'
  )
 
  METRICS (
    orders.m_gross_revenue AS SUM(orders.f_gross)
      WITH SYNONYMS = ('gross sales')
      COMMENT = 'Gross revenue: sum of gross amount, all statuses',
    orders.m_net_revenue AS SUM(
      CASE WHEN orders.ORDER_STATUS = 'SHIPPED'
             AND customers.d_is_internal = FALSE
           THEN orders.f_net ELSE 0 END)
      WITH SYNONYMS = ('revenue', 'net sales')
      COMMENT = 'AUTHORITATIVE REVENUE. Gross less discount less returns, shipped orders only, excluding internal accounts. Owner: Finance (Revenue Reporting).',
    orders.m_order_count AS COUNT(orders.ORDER_ID)
      COMMENT = 'Number of order lines',
    customers.m_customer_count AS COUNT(customers.CUSTOMER_ID)
      COMMENT = 'Number of distinct customers'
  )
 
  COMMENT = 'Governed semantic contract for sales analytics. Metric owner: Finance. Do not add metrics without sign-off.'
 
  AI_SQL_GENERATION 'Always report currency amounts rounded to 2 decimal places. When a question does not specify a period, state the period used in the answer.'
 
  AI_QUESTION_CATEGORIZATION 'Reject any question about employees, payroll, or individual customer contacts and tell the user this assistant covers sales performance only. If a revenue question does not specify gross or net, treat it as net revenue and say so.'
;

